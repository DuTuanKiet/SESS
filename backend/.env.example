# Copy file này thành .env rồi điền giá trị thật
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

MONGO_URI=mongodb://127.0.0.1:27017/sess_db

# Bắt buộc phải đổi thành chuỗi ngẫu nhiên đủ dài khi deploy production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
MAX_ACTIVE_SESSIONS=5

OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
# Nhập sai quá số lần này -> huỷ OTP; chờ đủ số giây mới được gửi lại OTP (chống spam)
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limit chống brute-force/scan API (theo IP trong 1 cửa sổ thời gian)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=100
# CHỈ DEV: trả OTP trong response để test. Production luôn để false.
EXPOSE_OTP_IN_DEV=true

# Regex email sinh viên: /^[a-zA-Z0-9._%+-]+@student\.ctuet\.edu\.vn$/i (src/utils/validation.js)

# Google OAuth Client (Web client) - dùng để verify idToken từ frontend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP: SMTP_PASS = App Password (không phải mật khẩu Gmail thường)
# Thiếu SMTP_PASS -> hệ thống tự in email ra console (chế độ dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SESS System <no-reply@ctuet.edu.vn>

# Tài khoản seed để test: npm run seed:admin | npm run seed:student
ADMIN_EMAIL=admin@ctuet.edu.vn
ADMIN_PASSWORD=
STUDENT_EMAIL=dtkietktpm2311025@student.ctuet.edu.vn
STUDENT_PASSWORD=
STUDENT_ID=KTPM2311025

